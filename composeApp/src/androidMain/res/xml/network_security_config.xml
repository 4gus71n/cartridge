<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS everywhere (Pages, the Cloudflare tunnel, creator-hosted games), except
     loopback, where the WebView loads downloaded games from the in-app
     LocalGameServer, and the dev backend on this Mac (emulator alias / LAN). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.1.24</domain>
        <domain includeSubdomains="false">agustins-macbook-pro.local</domain>
    </domain-config>
</network-security-config>
