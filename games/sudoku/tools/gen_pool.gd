extends SceneTree
## Offline puzzle-pool generator (not exported):
##   godot --headless --path . --script tools/gen_pool.gd -- [per_level] [seed]
## Generates rotationally symmetric unique-solution puzzles, grades them by
## technique tier, tops Easy/Medium up with extra clues (grade-preserving) and
## writes scripts/puzzle_pool.gd. Every entry is re-verified before writing.

const OUT := "res://scripts/puzzle_pool.gd"
## Target clue counts per level (extra clues make Easy/Medium friendlier).
const TARGET := {1: 36, 2: 30, 3: 0}


func _initialize() -> void:
	var args := OS.get_cmdline_user_args()
	var per: int = int(args[0]) if args.size() > 0 else 300
	var seed_value: int = int(args[1]) if args.size() > 1 else 20261017
	var rng := RandomNumberGenerator.new()
	rng.seed = seed_value
	var pools := {1: [], 2: [], 3: []}
	var seen := {}
	var made := 0
	var expert := 0
	var t0 := Time.get_ticks_msec()
	while pools[1].size() < per or pools[2].size() < per or pools[3].size() < per:
		var r := SudokuGenerator.make_puzzle(rng)
		made += 1
		var lv := SudokuGrader.grade(r.puzzle)
		if lv == SudokuGrader.EXPERT:
			expert += 1
			continue
		if pools[lv].size() >= per:
			continue
		var p: PackedInt32Array = r.puzzle
		if TARGET[lv] > 0:
			p = SudokuGenerator.add_clues(p, r.solution, TARGET[lv], lv, rng)
		var key := SudokuGrid.stringify(p)
		if seen.has(key):
			continue
		# Re-verify: unique solution, same grade, logical solve reaches the solution.
		if SudokuSolver.count_solutions(p, 2) != 1 or SudokuGrader.grade(p) != lv:
			push_warning("rejected after top-up")
			continue
		seen[key] = true
		pools[lv].append(key)
		if made % 200 == 0:
			print("made %d  easy %d  medium %d  hard %d  expert %d  (%ds)" % [made, pools[1].size(),
				pools[2].size(), pools[3].size(), expert, (Time.get_ticks_msec() - t0) / 1000])
	var lines := PackedStringArray()
	lines.append("class_name PuzzlePool")
	lines.append("extends RefCounted")
	lines.append("## GENERATED by tools/gen_pool.gd (seed %d) - do not edit by hand." % seed_value)
	lines.append("## Unique-solution puzzles graded by SudokuGrader; '.' = empty cell.")
	lines.append("")
	for lv in [1, 2, 3]:
		var name: String = ["", "EASY", "MEDIUM", "HARD"][lv]
		lines.append("const %s := [" % name)
		for s: String in pools[lv]:
			lines.append("\t\"%s\"," % s)
		lines.append("]")
		lines.append("")
	var f := FileAccess.open(OUT, FileAccess.WRITE)
	f.store_string("\n".join(lines))
	f.close()
	print("gen_pool: wrote %d per level from %d candidates (%d expert skipped) in %ds" % [per, made,
		expert, (Time.get_ticks_msec() - t0) / 1000])
	quit(0)
