# Copy to .env and fill in.

# Local development (default): SQLite file next to the backend
DATABASE_URL=sqlite:///./cartridge.db

# Supabase (Postgres) — use the pooler connection string from
# Supabase Dashboard -> Project Settings -> Database
# DATABASE_URL=postgresql+psycopg2://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_DAYS=30

# Emails (comma separated) that become admins on signup
ADMIN_EMAILS=admin@cartridge.local

# Public base URL of this backend (used in package URLs)
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Optional: GitHub token for the candidate import script (higher rate limits)
# GITHUB_TOKEN=
