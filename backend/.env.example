# Copy to backend/.env (never commit the real one).
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAILS=agustin.tomas.larghi@gmail.com
# Public URL used in links/thumbnails served by the API (the tunnel sets the app-facing one).
PUBLIC_BASE_URL=http://127.0.0.1:8123
# Docker only: lets the container push catalog.json to the Pages repo.
GITHUB_TOKEN=
# Optional fixed API URL (named tunnel / VPS). Leave empty with quick tunnels.
CARTRIDGE_PUBLIC_API=
TAKEDOWN_CONTACT=
